---
import '../styles/global.css';
import { experience, skills, packages } from '../data/portfolio';
const title = 'Sean Hewitson — Senior Software Engineer';
const description = 'Self-taught full-stack software engineer based in Plymouth, UK. Explore Bookahead, TV tiempo, open-source packages, and my experience building web applications.';
const schema = { '@context': 'https://schema.org', '@type': 'ProfilePage', url: 'https://seanhewitson.com/', mainEntity: { '@type': 'Person', name: 'Sean Hewitson', jobTitle: 'Senior Software Engineer', url: 'https://seanhewitson.com/', email: 'hello@seanhewitson.com', homeLocation: { '@type': 'Place', name: 'Plymouth, UK' }, sameAs: ['https://github.com/seannhewitson', 'https://uk.linkedin.com/in/sean-hewitson-4375101b0'], knowsAbout: skills.flatMap(group => group.items) } };
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8fafc" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (() => {
        const key = 'portfolio-theme';
        const system = window.matchMedia('(prefers-color-scheme: dark)');
        const valid = value => ['light', 'dark', 'system'].includes(value) ? value : 'system';
        let preference = 'system';
        try { preference = valid(localStorage.getItem(key)); } catch {}
        const apply = () => {
          const theme = preference === 'system' ? (system.matches ? 'dark' : 'light') : preference;
          document.documentElement.dataset.theme = theme;
          document.querySelector('meta[name="theme-color"]').content = theme === 'dark' ? '#0b1120' : '#f8fafc';
          const control = document.getElementById('theme-choice');
          if (control) control.value = preference;
        };
        apply();
        system.addEventListener('change', apply);
        window.addEventListener('storage', event => {
          if (event.key === key || event.key === null) { preference = valid(event.newValue); apply(); }
        });
        document.addEventListener('DOMContentLoaded', () => {
          apply();
          document.getElementById('theme-choice')?.addEventListener('change', event => {
            preference = valid(event.target.value);
            try { localStorage.setItem(key, preference); } catch {}
            apply();
          });
        }, { once: true });
      })();
    </script>
    <link rel="canonical" href="https://seanhewitson.com/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://seanhewitson.com/" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="header wrap">
      <a href="#" class="wordmark" aria-label="Sean Hewitson home">sh<span>.</span></a>
      <nav aria-label="Main navigation"><a href="#work">Work</a><a href="#experience">Experience</a><a href="#about">About</a></nav>
      <div class="header-actions">
        <a class="header-contact" href="mailto:hello@seanhewitson.com">Let’s talk <span aria-hidden="true">↗</span></a>
        <label class="theme-control" for="theme-choice"><span>Theme</span><select id="theme-choice" aria-label="Colour theme"><option value="light">Light</option><option value="dark">Dark</option><option value="system" selected>System</option></select></label>
      </div>
    </header>
    <main id="main">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-top"><p class="eyebrow">Sean Hewitson / Software Engineer</p><p class="location">Plymouth, UK <span>·</span> Working remotely</p></div>
        <h1 id="hero-title">Thoughtful code.<br /><span>Useful things.</span></h1>
        <div class="hero-bottom"><p>I’m Sean, a self-taught full-stack engineer.<br class="desktop-break" /> I turn complex problems into simple, reliable<br class="desktop-break" /> web applications — from the first idea to production.</p><div class="hero-actions"><a class="button" href="#work">Explore my work <span aria-hidden="true">↘</span></a><a class="text-link" href="#experience">View my résumé <span aria-hidden="true">↓</span></a></div></div>
        <div class="hero-foot"><span>Building for the web since 2019</span><span>Full stack. End to end.</span></div>
      </section>
      <section id="work" class="work wrap" aria-labelledby="work-title">
        <div class="section-heading"><div><p class="eyebrow">01 / Selected work</p><h2 id="work-title">Ideas, made real.</h2></div><p>Independent projects. <br />Built with care, used in the real world.</p></div>
        <div class="project-grid">
          <article class="project">
            <a class="project-image bookahead" href="https://www.bookahead.co.uk" target="_blank" rel="noopener noreferrer" aria-label="Visit Bookahead (opens in a new tab)"><div class="image-top"><span>bookahead</span><span aria-hidden="true">↗</span></div><img src="/images/bookahead.webp" width="1440" height="1000" alt="Bookahead website introducing its booking and business management platform" loading="lazy" /></a>
            <div class="project-heading"><h3><a href="https://www.bookahead.co.uk" target="_blank" rel="noopener noreferrer">Bookahead <span aria-hidden="true">↗</span></a></h3><span class="project-kind">Booking platform</span></div>
            <p>Less admin. More time for the work that matters. A booking platform for service businesses, bringing appointments, payments, customers, and teams together.</p>
            <ul class="tags" aria-label="Bookahead technologies"><li>Next.js</li><li>Supabase</li><li>Stripe</li><li>TypeScript</li></ul>
            <button class="screenshot-link" data-image="/images/bookahead-storefront.webp" data-caption="Bookahead’s customer booking storefront" type="button">View booking experience <span aria-hidden="true">↗</span></button>
          </article>
          <article class="project">
            <a class="project-image tiempo" href="https://www.tvtiempo.app" target="_blank" rel="noopener noreferrer" aria-label="Visit TV tiempo (opens in a new tab)"><div class="image-top"><span>TV tiempo</span><span aria-hidden="true">↗</span></div><img src="/images/tvtiempo.webp" width="1440" height="1000" alt="TV tiempo’s TV discovery page with featured shows and recommendations" loading="lazy" /></a>
            <div class="project-heading"><h3><a href="https://www.tvtiempo.app" target="_blank" rel="noopener noreferrer">TV tiempo <span aria-hidden="true">↗</span></a></h3><span class="project-kind">Find a show together</span></div>
            <p>Find your next watch, together. Match on shows you want to watch and discover something you can both get into, with discovery and tracking to keep your favourites close.</p>
            <ul class="tags" aria-label="TV tiempo technologies"><li>Next.js</li><li>React</li><li>Supabase</li><li>TMDB</li></ul>
          </article>
        </div>
        <article class="archive-project"><div><span class="archive-number">03</span><h3>LootLink</h3><span class="archive-label">Archived</span></div><p>A competition and giveaway platform, with a companion Discord bot for managing community giveaways.</p><span class="archive-note">A past project, now retired.</span></article>
      </section>
      <section class="open-source wrap" aria-labelledby="open-title"><div class="section-heading compact"><div><p class="eyebrow">Beyond the browser</p><h2 id="open-title">Small tools. Real utility.</h2></div><a class="text-link" href="https://github.com/seannhewitson" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a></div>
        <div class="package-grid">{packages.map(pkg => <a class="package" href={pkg.href} target="_blank" rel="noopener noreferrer"><div class="package-name"><span aria-hidden="true">{ '{ }' }</span><span aria-hidden="true">↗</span></div><h3>{pkg.name}</h3><p>{pkg.description}</p><span class="package-meta">{pkg.status}</span></a>)}</div>
        <div class="bots"><span class="eyebrow">Also in the toolbox</span><p><strong>Warzone Bot</strong> — AI-assisted tournament tooling.</p><p><strong>Dart Bot</strong> — private tournaments and leagues.</p></div>
      </section>
      <section id="experience" class="experience" aria-labelledby="experience-title"><div class="wrap experience-layout"><div class="experience-intro"><p class="eyebrow">02 / Experience</p><h2 id="experience-title">The journey <br />so far.</h2><p>From retail systems to SaaS products.<br />Always building, always learning.</p><button class="text-link print-button" type="button">Print / save résumé <span aria-hidden="true">↗</span></button></div><div class="timeline">{experience.map((job, i) => <article class="job"><div class="job-top"><span>{job.dates}</span>{i === 0 && <span class="current">Current</span>}</div><h3>{job.company}</h3><p class="role">{job.role}</p><ul>{job.points.map(point => <li>{point}</li>)}</ul></article>)}</div></div></section>
      <section id="about" class="about wrap" aria-labelledby="about-title"><div class="about-intro"><p class="eyebrow">03 / A little about me</p><h2 id="about-title">Curiosity is<br />part of the stack.</h2><p>I’m a self-taught engineer based in Plymouth, working remotely. I enjoy the whole process of building software: understanding the problem, designing the architecture, and getting the details right.</p><p>Alongside my professional work, I build my own products and open-source tools. It’s how I explore new ideas and keep learning.</p><a class="text-link" href="https://uk.linkedin.com/in/sean-hewitson-4375101b0" target="_blank" rel="noopener noreferrer">Find me on LinkedIn <span aria-hidden="true">↗</span></a></div><div class="skills">{skills.map(group => <div class="skill-group"><h3>{group.label}</h3><ul>{group.items.map(item => <li>{item}</li>)}</ul></div>)}</div></section>
      <section id="contact" class="contact wrap"><p class="eyebrow">Have something in mind?</p><h2>Let’s build<br /><span>something useful.</span></h2><a class="contact-email" href="mailto:hello@seanhewitson.com">hello@seanhewitson.com <span aria-hidden="true">↗</span></a></section>
    </main>
    <footer class="footer wrap"><span>© {new Date().getFullYear()} Sean Hewitson</span><div><a href="https://github.com/seannhewitson" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="https://uk.linkedin.com/in/sean-hewitson-4375101b0" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href="#">Back to top ↑</a></div></footer>
    <dialog class="image-dialog" aria-labelledby="image-caption"><button type="button" class="close-dialog" aria-label="Close screenshot">Close ×</button><figure><img alt="" width="1440" height="1000" /><figcaption id="image-caption"></figcaption></figure></dialog>
    <script>
      document.querySelector('.print-button')?.addEventListener('click', () => window.print());
      const dialog = document.querySelector<HTMLDialogElement>('.image-dialog');
      document.querySelectorAll<HTMLButtonElement>('[data-image]').forEach(button => button.addEventListener('click', () => {
        if (!dialog) return;
        const image = dialog.querySelector('img')!;
        image.src = button.dataset.image!;
        image.alt = button.dataset.caption!;
        dialog.querySelector('figcaption')!.textContent = button.dataset.caption!;
        dialog.showModal();
      }));
      dialog?.querySelector('button')?.addEventListener('click', () => dialog.close());
      dialog?.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
    </script>
  </body>
</html>
